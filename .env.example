# Server-side environment example. Replace placeholders locally; never commit .env.

APP_ENV=development
APP_NAME=ai-data-agent
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

DATASOURCE_ENABLED=false
DATASOURCE_ID=demo_mysql
DATASOURCE_NAME=授权测试数据源

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=authorized_test_db
DB_USER=readonly_demo
DB_PASSWORD=replace_me
DB_SSL_ENABLED=false
DB_SSL_CA_PATH=

DB_ALLOWED_OBJECTS_JSON='{}'

SCHEMA_CACHE_TTL_SECONDS=60
DB_CONNECT_TIMEOUT_SECONDS=5
DB_METADATA_TIMEOUT_SECONDS=5
DB_TOTAL_TIMEOUT_SECONDS=15
DB_METADATA_MAX_OBJECTS=200
DB_METADATA_MAX_COLUMNS=2000

QUERY_TOTAL_TIMEOUT_SECONDS=10
QUERY_SERVER_TIMEOUT_SECONDS=8
QUERY_POOL_MAX_CONNECTIONS=2
QUERY_POOL_MAX_WAITERS=4
QUERY_POOL_ACQUIRE_TIMEOUT_SECONDS=2
QUERY_MAX_ROWS=200
QUERY_HARD_MAX_ROWS=1000
QUERY_MAX_CELL_BYTES=65536
QUERY_MAX_RESULT_BYTES=1048576
QUERY_MAX_SQL_BYTES=8192

LLM_BASE_URL=https://example-llm-provider.invalid/v1
LLM_API_KEY=replace_me
LLM_MODEL=provider-model-id
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0

# 运行时设置（可选）：管理员也可通过前端“设置”界面或 /api/v1/settings API
# 配置 LLM 与数据源，保存到 data/runtime_settings.json（权限 600），
# 并覆盖上述环境变量默认值，保存即生效、无需重启。

AGENT_REQUEST_TIMEOUT_SECONDS=150
MAX_TOOL_CALLS=8
SQL_AUTO_RETRY_MAX=1
AGENT_TOOL_RESULT_MAX_ROWS=50
AGENT_CONTEXT_MESSAGES=20
SESSION_DB_PATH=./data/agent_sessions.sqlite3
BUSINESS_TERMS_PATH=config/business_terms.yaml
APP_TIMEZONE=Asia/Shanghai
