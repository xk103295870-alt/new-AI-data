{
  "name": "ai-data-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:unavailable": "playwright test --config playwright.unavailable.config.ts",
    "test:e2e:datasource": "playwright test --config playwright.datasource.config.ts",
    "test:e2e:chat": "playwright test --config playwright.chat.config.ts",
    "test:e2e:i18n": "playwright test --config playwright.i18n.config.ts",
    "test:e2e:real": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "element-plus": "^2.14.7",
    "vue": "^3.5.44",
    "vue-echarts": "8.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
